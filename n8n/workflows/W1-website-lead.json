    {
      "id": "441fec66-f296-4d36-8ada-a55d582c68e6",
      "name": "Prepare lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "  // Clean the form data and normalise the phone. The phone function is the same one as\n  // n8n/snippets/normalize-phone.js (rule 7) - keep them identical.\n  function normalizeIndianPhone(raw) {\n    if (raw === null || raw === undefined) return { phone: null, valid: false };\n    let digits = String(raw).replace(/\\D/g, '');\n    if (digits.startsWith('0091')) digits = digits.slice(4);\n    else if (digits.length === 12 && digits.startsWith('91')) digits = digits.slice(2);\n    else if (digits.length === 11 && digits.startsWith('0')) digits = digits.slice(1);\n    const valid = /^[6-9]\\d{9}$/.test(digits);\n    return { phone: valid ? `+91${digits}` : null, valid };\n  }\n\n  const body = $json.body || {};\n  const noControl = (v) => String(v === null || v === undefined ? '' : v).replace(/[\\u0000-\\u0008\\u000b-\\u001f\\u007f]/g, '');\n  const line = (v, max) => noControl(v).replace(/\\s+/g, ' ').trim().slice(0, max);\n  const text = (v, max) => noControl(v).trim().slice(0, max);\n\n  const slug = line(body.clinic, 40).toLowerCase();\n  const clinic_slug = /^[a-z0-9-]{2,40}$/.test(slug) ? slug : '';\n  const name = line(body.name, 100);\n  const { phone, valid } = normalizeIndianPhone(body.phone);\n  const honeypot = line(body.website, 200);   // hidden field: humans leave it empty, bots fill it\n\n  let skip_reason = '';\n  if (honeypot) skip_reason = 'honeypot filled';\n  else if (!name) skip_reason = 'missing name';\n  else if (!valid) skip_reason = 'invalid phone';\n\n  return {\n    json: {\n      grist_base_url: String($json.grist_base_url || '').replace(/\\/+$/, ''),\n      registry_doc_id: String($json.registry_doc_id || '').trim(),\n      clinic_slug,\n      name,\n      phone,\n      phone_raw: line(body.phone, 30),\n      enquiry: text(body.enquiry, 1000),\n      page_url: line(body.page_url, 500),\n      utm_campaign: line(body.utm_campaign, 100),\n      input_ok: skip_reason === '',\n      skip_reason,\n    },\n  };\n"
      }
    },
