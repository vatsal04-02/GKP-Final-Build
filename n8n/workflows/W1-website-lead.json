    {
      "id": "2f2f52b6-482f-466c-bb78-61087383b83b",
      "name": "Build update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -160
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "  const ctx = $('Resolve clinic').first().json;\n  const rec = $json.records[0];\n  const old = String(rec.fields.Enquiry || '');\n  const today = new Date(Date.now() + 5.5 * 3600 * 1000).toISOString().slice(0, 10);   // IST date\n\n  const fields = {};\n  if (ctx.enquiry && !old.includes(ctx.enquiry)) {\n    fields.Enquiry = old ? `${old}\\n---\\n${today}: ${ctx.enquiry}` : ctx.enquiry;\n  }\n  if (ctx.page_url && ctx.page_url !== String(rec.fields.Page_URL || '')) fields.Page_URL = ctx.page_url;                 // only if it changed,\n  if (ctx.utm_campaign && ctx.utm_campaign !== String(rec.fields.UTM_Campaign || '')) fields.UTM_Campaign = ctx.utm_campaign;   // so a double-submit is a duplicate\n\n  const has_changes = Object.keys(fields).length > 0;\n  return {\n    json: {\n      ...ctx,\n      action: 'updated',\n      lead_id: rec.fields.Lead_ID || `row ${rec.id}`,\n      has_changes,\n      skip_reason: has_changes ? '' : 'duplicate submission',\n      patch: { records: [{ id: rec.id, fields }] },\n    },\n  };\n"
      }
    },
