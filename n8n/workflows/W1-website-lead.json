    {
      "id": "6cb97d87-aa3a-475f-87b3-fd3c11bda5c8",
      "name": "Build new lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        60
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "  const ctx = $('Resolve clinic').first().json;\n  const now = Date.now();\n  const ymd = new Date(now + 5.5 * 3600 * 1000).toISOString().slice(0, 10).replace(/-/g, '');   // IST date\n  const prefix = `L-${ymd}-`;\n\n  let max = 0;\n  for (const r of $json.records || []) {\n    const id = String((r.fields || {}).Lead_ID || '');\n    if (id.startsWith(prefix)) max = Math.max(max, parseInt(id.slice(prefix.length), 10) || 0);\n  }\n  const lead_id = prefix + String(max + 1).padStart(4, '0');\n\n  const fields = {\n    Lead_ID: lead_id,\n    Created_At: Math.floor(now / 1000),   // Grist DateTime = epoch seconds\n    Name: ctx.name,\n    Phone: ctx.phone,\n    Source: 'Website',\n    Page_URL: ctx.page_url,\n    UTM_Campaign: ctx.utm_campaign,\n    Enquiry: ctx.enquiry,\n    Status: 'New',\n  };\n  return { json: { ...ctx, action: 'created', lead_id, create: { records: [{ fields }] } } };\n"
      }
    },
