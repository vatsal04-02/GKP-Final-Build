    {
      "id": "266d78c7-b9c2-4fd8-8313-04504147e8df",
      "name": "Resolve clinic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "  const ctx = $('Prepare lead').first().json;\n  const rec = ($json.records || [])[0];\n  const f = rec ? rec.fields || {} : {};\n  const found = !!(rec && ctx.clinic_slug && f.Clinic_Slug === ctx.clinic_slug && f.Active === true && f.Grist_Doc_ID);\n  return {\n    json: {\n      ...ctx,\n      clinic_found: found,\n      doc_id: found ? String(f.Grist_Doc_ID).trim() : '',\n      clinic_name: found ? String(f.Clinic_Name || '') : '',\n      wa_phone_number_id: found ? String(f.WA_Phone_Number_ID || '') : '',\n    },\n  };\n"
      }
    },
