        "url": "={{ $('Resolve clinic').first().json.grist_base_url }}/api/docs/{{ $('Resolve clinic').first().json.doc_id }}/tables/Leads/records",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
