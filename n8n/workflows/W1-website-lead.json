    {
      "id": "d08bf804-a79b-49f1-a7dd-4cb6575f3431",
      "name": "Staff alert (stub)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        -80
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "  const from = (name) => {\n    try { return $(name).first().json; } catch (e) { return null; }   // throws if that branch did not run\n  };\n  const ctx = from('Build update') || from('Build new lead');\n\n  const quote = ctx.enquiry ? ` - \"${ctx.enquiry.slice(0, 200)}\"` : '';\n  const what = ctx.action === 'created' ? 'New website lead' : 'Existing lead enquired again';\n  const staff_alert_text = `${what} (${ctx.clinic_name || ctx.clinic_slug}): ${ctx.name}, ${ctx.phone}${quote}. ${ctx.lead_id}.`;\n\n  // STUB: nothing is sent. The real WhatsApp alert comes in a later slice and must follow rules 4 and 5\n  // (sent flag, Opted_Out / Automation_Paused, quiet hours 21:00-08:00 IST, TEST_MODE).\n  return {\n    json: {\n      ...ctx,\n      staff_alert_text,\n      staff_alert_sent: false,\n      log: {\n        Workflow: 'W1-website-lead',\n        Record: `${ctx.lead_id} (${ctx.action})`,\n        Outcome: 'ok',\n        Error: '',\n        At: Math.floor(Date.now() / 1000),\n      },\n    },\n  };\n"
      }
    },
    {
      "id": "92966438-01dc-42b7-8a78-41c7bb2bd381",
      "name": "Log skipped",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "  return {\n    json: {\n      ...$json,\n      log: {\n        Workflow: 'W1-website-lead',\n        Record: $json.phone || $json.phone_raw || '',\n        Outcome: 'skipped',\n        Error: $json.skip_reason || 'unknown',\n        At: Math.floor(Date.now() / 1000),\n      },\n    },\n  };\n"
      }
    },
    {
      "id": "e2c8af2a-bf63-4406-b726-c33cc957fc68",
