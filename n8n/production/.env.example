# FlowHQ Clinic Automation - PRODUCTION environment. Copy to `.env` (chmod 600, never commit, never paste it anywhere) and replace every CHANGE_ME.
# Placeholders only: this file contains no real value. See DEPLOYMENT.md for where each value comes from.

# ---------------------------------------------------------------- server / reverse proxy
N8N_DOMAIN=n8n.example.com              # public host for the webhooks (DNS A record -> server)
N8N_ADMIN_DOMAIN=n8n-admin.example.com  # editor host: reachable ONLY from ADMIN_ALLOW_CIDR (or leave unused and use an SSH tunnel)
ADMIN_ALLOW_CIDR=203.0.113.10/32        # your office / VPN address(es), space separated
GRIST_DOMAIN=crm.example.com
ACME_EMAIL=ops@example.com
N8N_VERSION=2.43.5                      # pinned: the version these tests ran against. Upgrade deliberately, re-run the tests.
GRIST_VERSION=CHANGE_ME                 # pin an exact gristlabs/grist tag
TZ=Asia/Kolkata

# ---------------------------------------------------------------- secrets that live in files (created by scripts/init-secrets.sh, chmod 600)
# secrets/n8n_encryption_key        n8n encrypts every stored credential with it. LOSE IT = every credential is unreadable. Back it up separately.
GRIST_SESSION_SECRET=CHANGE_ME          # long random string
GRIST_ADMIN_EMAIL=you@example.com
GRIST_TEAM_NAME=agency
GOOGLE_CLIENT_ID=CHANGE_ME              # Grist sign-in (OIDC)
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ---------------------------------------------------------------- read by the workflow at run time (the n8n container gets exactly these)
FLOWHQ_GRIST_URL=http://grist:8484      # internal Docker address; the Grist API key is the n8n credential "FlowHQ Grist API"
FLOWHQ_REGISTRY_DOC_ID=CHANGE_ME        # Grist document id of the Agency Registry (table Clinics)
FLOWHQ_DEFAULT_COUNTRY_CODE=91          # numbers written without + get this country code (91 = India)

# WhatsApp (Meta Cloud API). Start in allowlist mode with your own numbers. "live" only after the go-live checklist.
FLOWHQ_WA_SEND_MODE=allowlist           # allowlist | live | off
FLOWHQ_WA_ALLOWLIST=+910000000000       # comma separated E.164 numbers that may receive messages in allowlist mode
FLOWHQ_WA_GRAPH_VERSION=v23.0           # check Meta's changelog; must look like v23.0
FLOWHQ_WA_TEMPLATE_LANGUAGE=en          # language code of the approved templates (templates/whatsapp-templates.md)
FLOWHQ_WA_ALLOW_HELLO_WORLD=false       # true only for a smoke test on Meta's test number
# FLOWHQ_WA_GRAPH_BASE_URL=https://graph.facebook.com   # leave unset in production (tests use a local mock)
FLOWHQ_META_APP_SECRET=CHANGE_ME        # Meta app > Settings > Basic > App secret: signs every inbound POST (X-Hub-Signature-256). min 16 chars
FLOWHQ_META_VERIFY_TOKEN=CHANGE_ME      # any long random string; the same value goes into the Meta webhook setup. min 16 chars
FLOWHQ_W2_IMPLIED_CONSENT=true          # a patient who starts the chat is recorded as consenting to be answered (set false to require staff to tick it)

# Website form + Cal.com
FLOWHQ_W1_REQUIRE_CONSENT=true          # the website form must send consent_whatsapp (checkbox)
FLOWHQ_CAL_WEBHOOK_SECRET=CHANGE_ME     # the "Secret" of the Cal.com webhook. min 16 chars
FLOWHQ_CAL_MAX_AGE_HOURS=24             # replay window for Cal.com events

# Alerts, testing
FLOWHQ_TELEGRAM_CHAT_ID=CHANGE_ME       # negative number of the agency alert group; empty = no Telegram alerts
FLOWHQ_TEST_PHONE=+910000000000         # used by W3 as a fallback test number

# E-mail (staff alert for website enquiries). Empty FLOWHQ_ALERT_EMAIL_TO = no e-mail.
FLOWHQ_ALERT_EMAIL_TO=
FLOWHQ_EMAIL_FROM=noreply@example.com
FLOWHQ_EMAIL_PATIENT_ACK=false          # true = acknowledgement e-mail to people who gave an address AND e-mail consent

# External AI (OFF by default). Turning it on sends masked patient messages and weekly numbers to the provider: read PRIVACY.md first.
FLOWHQ_AI_EXTERNAL_ENABLED=false
FLOWHQ_AI_MODEL=openai/gpt-4o-mini
FLOWHQ_AI_MAX_REPLIES_PER_HOUR=6
# FLOWHQ_AI_BASE_URL=https://openrouter.ai/api/v1       # leave unset in production

# ---------------------------------------------------------------- used ONLY by scripts/create-credentials.js (NOT passed to the n8n container)
FLOWHQ_GRIST_API_KEY=CHANGE_ME          # Grist > profile > API key of a service user that can edit the clinic documents
FLOWHQ_W1_WEBHOOK_SECRET=CHANGE_ME      # value of the X-Lead-Secret header the website form sends
FLOWHQ_WA_ACCESS_TOKEN=CHANGE_ME        # permanent System User token (whatsapp_business_messaging)
FLOWHQ_AI_API_KEY=                      # only when FLOWHQ_AI_EXTERNAL_ENABLED=true
FLOWHQ_TELEGRAM_BOT_TOKEN=CHANGE_ME
FLOWHQ_SMTP_HOST=smtp.example.com       # staging: mailpit
FLOWHQ_SMTP_PORT=587
FLOWHQ_SMTP_USER=CHANGE_ME
FLOWHQ_SMTP_PASSWORD=CHANGE_ME
FLOWHQ_SMTP_SECURE=false                # true = implicit TLS (port 465); false = STARTTLS (587)

# ---------------------------------------------------------------- backups (scripts/backup.sh)
BACKUP_DIR=/var/backups/flowhq
BACKUP_PASSPHRASE=CHANGE_ME             # encrypts the archives. Keep it OUTSIDE the server.
BACKUP_KEEP_DAYS=14
