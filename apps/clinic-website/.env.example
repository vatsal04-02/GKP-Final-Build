# Public URL the site is deployed to (canonical URL, sitemap, social tags).
PUBLIC_SITE_URL=https://geeta-krishna.grexa.site

# Optional. Leave empty to ship with no analytics. Add only after the clinic approves GA4.
PUBLIC_GA_ID=

# ---- Enquiry form (server-side only: set these in Vercel > Settings > Environment Variables, never with a PUBLIC_ prefix) ----
# See ENQUIRY_INTEGRATION.md. The enquiry API (api/enquiry.mjs) forwards the booking form to the clinic's n8n website-lead webhook.
# N8N_WEBHOOK_URL=          # start with the n8n TEST url (.../webhook-test/website-lead); the production url only after the clinic approves go-live
# N8N_WEBHOOK_SECRET=       # a secret made for THIS webhook only (the value of n8n credential "FlowHQ W1 Webhook Auth"); never an OpenRouter or Grist key; never commit it
# N8N_WEBHOOK_AUTH_HEADER=X-Lead-Secret   # that credential's header name
# CLINIC_SLUG=              # the Clinic_Slug of this clinic in the Agency Registry (Grist table Clinics)
# ALLOWED_ORIGINS=          # optional, comma separated, e.g. https://physio-two-umber.vercel.app
# N8N_TIMEOUT_MS=8000
# Optional, browser-visible: only if the API lives somewhere other than this site's /api/enquiry
# PUBLIC_ENQUIRY_ENDPOINT=

# ---- Live Google reviews (server-side only; api/reviews.mjs; see README > Live Google reviews) ----
# GOOGLE_PLACES_API_KEY=    # Google Cloud API key restricted to "Places API (New)"; never commit it, never PUBLIC_
# GOOGLE_PLACE_ID=          # the clinic's Google place id (Place ID Finder)
