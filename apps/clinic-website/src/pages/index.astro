---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Ticker from '../components/Ticker.astro';
import About from '../components/About.astro';
import Conditions from '../components/Conditions.astro';
import WhyApproach from '../components/WhyApproach.astro';
import Doctors from '../components/Doctors.astro';
import Gallery from '../components/Gallery.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Reviews from '../components/Reviews.astro';
import ContactCta from '../components/ContactCta.astro';
import Faq from '../components/Faq.astro';
import Booking from '../components/Booking.astro';
import PayBooking from '../components/PayBooking.astro';
import VisitUs from '../components/VisitUs.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <Booking />
    <PayBooking />
    <TrustStrip />
    <Ticker />
    <About />
    <Conditions />
    <WhyApproach />
    <Doctors />
    <Gallery />
    <HowItWorks />
    <Reviews />
    <ContactCta />
    <Faq />
    <VisitUs />
  </main>
  <Footer />
  <StickyCta />
</Base>