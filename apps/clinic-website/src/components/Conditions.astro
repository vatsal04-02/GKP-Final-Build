---
import Depth from './Depth.astro';
import BodyMap from './BodyMap.astro';
import Icon from './Icon.astro';
import { conditionMessage, conditions, whatsappLink, links } from '../data/site';
---

<section id="conditions" class="section curve surface-tint" data-section data-ambient aria-labelledby="conditions-title">
  <Depth tone="light" glow mirror />

  <div class="container-site relative">
    <header class="head reveal">
      <div class="head__title">
        <p class="eyebrow">02 / Conditions</p>
        <h2 id="conditions-title" class="h2">Point to the pain. We’ll take it from there.</h2>
      </div>
      <p class="lead head__lead">
        Choose the concern closest to yours. The clinic will assess your individual condition before recommending care.
      </p>
    </header>

    <BodyMap />

    <ul class="grid">
      {
        conditions.map((c, i) => (
          <li class="cell reveal" style={`--i:${i % 3}`}>
            <a
              class="card"
              href={whatsappLink(conditionMessage(c.title))}
              target="_blank"
              rel="noopener noreferrer"
              data-track="condition_click"
              data-location="conditions"
              data-concern={c.title}
            >
              <span class="card__top">
                <span class="card__no" aria-hidden="true"></span>
                <span class="card__icon">
                  <Icon name={c.icon} size={19} />
                </span>
              </span>
              <span class="card__body">
                <span class="card__title">{c.title}</span>
                <span class="card__blurb">{c.blurb}</span>
              </span>
              <span class="card__go" aria-hidden="true">
                Ask the clinic
                <span class="card__line"></span>
              </span>
              <span class="sr-only"> — message the clinic on WhatsApp about this concern (opens in a new tab)</span>
            </a>
          </li>
        ))
      }

      <li class="cell cell--cta reveal" style="--i:1">
        <div class="cta">
          <div>
            <p class="cta__title">Not sure where to start?</p>
            <p class="cta__sub">Tell the clinic what you’re experiencing — they’ll point you to the next step.</p>
          </div>
          <a class="btn btn-primary btn-sm" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="conditions-cta">
            WhatsApp the clinic
            <Icon name="arrow-right" size={18} class="icon-arrow" />
          </a>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .relative {
    position: relative;
  }
  .head {
    display: grid;
    gap: 0.9rem;
    margin-bottom: clamp(24px, 3.5vw, 40px);
  }
  .head__title {
    display: grid;
    gap: 0.8rem;
  }
  .head__lead {
    max-width: 34rem;
  }

  /* Ruled "index card" grid: hairlines instead of floating tiles. Numbered, outlined icon, serif title, an action
     line at the foot. Hover fills the card with pine and draws the action line out. */
  .grid {
    counter-reset: cond;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(12 59 54 / 0.2);
    border-left: 1px solid rgb(12 59 54 / 0.2);
  }
  .cell {
    position: relative;
    display: flex;
    border-right: 1px solid rgb(12 59 54 / 0.2);
    border-bottom: 1px solid rgb(12 59 54 / 0.2);
  }
  /* Body-map landing: an orange ring pulses around the card for 1.2s (transform + opacity only) */
  .cell::after {
    content: '';
    position: absolute;
    inset: -3px;
    z-index: 2;
    border: 2px solid var(--color-cta);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cell.is-flash::after {
      animation: card-flash 1200ms ease-out both;
    }
  }
  /* Reduced motion: the same ring, held still for the same 1.2s */
  @media (prefers-reduced-motion: reduce) {
    .cell.is-flash::after {
      opacity: 1;
    }
  }
  @keyframes card-flash {
    0% {
      opacity: 0;
      transform: scale(0.98);
    }
    15% {
      opacity: 1;
      transform: scale(1);
    }
    40% {
      opacity: 0.35;
      transform: scale(1.01);
    }
    60% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.02);
    }
  }
  .cell--cta {
    grid-column: 1 / -1;
  }

  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 100%;
    padding: 1.15rem 1.2rem 1.1rem;
    background: transparent;
    color: var(--color-ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 260ms ease;
  }
  /* The pine fill rises from the bottom edge (transform only, so no repaint of the whole card) */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-pine);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 320ms var(--ease-soft);
  }
  .card:focus-visible {
    color: var(--color-ivory);
  }
  @media (hover: hover) {
    .card:hover {
      color: var(--color-ivory);
    }
  }
  .card:focus-visible::before {
    transform: scaleY(1);
  }
  @media (hover: hover) {
    .card:hover::before {
      transform: scaleY(1);
    }
  }
  .card:focus-visible {
    outline: 3px solid var(--color-cta);
    outline-offset: -3px;
  }

  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .cell {
    counter-increment: cond;
  }
  .card__no::before {
    content: counter(cond, decimal-leading-zero);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    color: rgb(12 59 54 / 0.55);
    transition: color 260ms ease;
  }
  .card:focus-visible .card__no::before {
    color: rgb(250 248 242 / 0.7);
  }
  @media (hover: hover) {
    .card:hover .card__no::before {
      color: rgb(250 248 242 / 0.7);
    }
  }
  .card__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1.5px solid var(--color-teal);
    color: var(--color-teal);
    transition:
      border-color 260ms ease,
      color 260ms ease;
  }
  .card:focus-visible .card__icon {
    border-color: var(--color-sand);
    color: var(--color-sand);
  }
  @media (hover: hover) {
    .card:hover .card__icon {
      border-color: var(--color-sand);
      color: var(--color-sand);
    }
  }

  .card__body {
    display: grid;
    gap: 0.35rem;
  }
  .card__title {
    font: 400 1.3125rem/1.15 var(--font-serif);
    color: var(--color-pine);
    text-wrap: balance;
    transition: color 260ms ease;
  }
  .card:focus-visible .card__title {
    color: var(--color-ivory);
  }
  @media (hover: hover) {
    .card:hover .card__title {
      color: var(--color-ivory);
    }
  }
  .card__blurb {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.875rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
    transition: color 260ms ease;
  }
  .card:focus-visible .card__blurb {
    color: rgb(250 248 242 / 0.82);
  }
  @media (hover: hover) {
    .card:hover .card__blurb {
      color: rgb(250 248 242 / 0.82);
    }
  }

  /* Action line: "Ask the clinic ———>" ; the line draws out on hover */
  .card__go {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-teal);
    transition: color 260ms ease;
  }
  .card:focus-visible .card__go {
    color: var(--color-sand);
  }
  @media (hover: hover) {
    .card:hover .card__go {
      color: var(--color-sand);
    }
  }
  .card__line {
    position: relative;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    transition: width 320ms var(--ease-soft);
  }
  .card__line::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    width: 6px;
    height: 6px;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    transform: rotate(45deg);
  }
  .card:focus-visible .card__line {
    width: 44px;
  }
  @media (hover: hover) {
    .card:hover .card__line {
      width: 44px;
    }
  }

  /* Closing tile (warm sand) spans the grid */
  .cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1.3rem 1.2rem 1.35rem;
    background: var(--color-sand);
  }
  .cta__title {
    font: 400 1.5rem/1.2 var(--font-serif);
    color: var(--color-pine);
  }
  .cta__sub {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--color-ink) 74%, transparent);
  }

  /* One column on phones: number, icon and title in a compact row so 13 cards don't become a very long scroll */
  @media (max-width: 639px) {
    .card {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: 1rem;
      min-height: 84px;
      padding: 0.85rem 1rem;
    }
    .card__top {
      display: contents;
    }
    .card__no {
      display: none;
    }
    .card__go {
      display: none;
    }
    .card__title {
      font-size: 1.1875rem;
    }
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .card {
      min-height: 176px;
      padding: 1.25rem 1.3rem 1.2rem;
    }
    .cta {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
      gap: 32px;
    }
    .head__title {
      grid-column: 1 / span 6;
    }
    .head__lead {
      grid-column: 8 / span 5;
      padding-bottom: 0.3rem;
    }
  }

</style>
