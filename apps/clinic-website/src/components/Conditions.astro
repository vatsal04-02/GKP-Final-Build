---
import Depth from './Depth.astro';
import BodyMap from './BodyMap.astro';
import Icon from './Icon.astro';
import { conditionMessage, conditions, whatsappLink, links } from '../data/site';
---

<section id="conditions" class="section curve surface-tint" data-section data-ambient aria-labelledby="conditions-title">
  <Depth tone="light" glow mirror />

  <div class="container-site relative">
    <header class="head reveal">
      <div class="head__title">
        <p class="eyebrow">02 / Conditions</p>
        <h2 id="conditions-title" class="h2">Point to the pain. We’ll take it from there.</h2>
      </div>
      <p class="lead head__lead">
        Choose the concern closest to yours. The clinic will assess your individual condition before recommending care.
      </p>
    </header>

    <BodyMap />

    <ul class="grid">
      {
        conditions.map((c, i) => (
          <li class="cell reveal" style={`--i:${i % 3}`}>
            <a
              class="card"
              href={whatsappLink(conditionMessage(c.title))}
              target="_blank"
              rel="noopener noreferrer"
              data-track="condition_click"
              data-location="conditions"
              data-concern={c.title}
            >
              <span class="card__top">
                <span class="card__icon">
                  <Icon name={c.icon} size={19} />
                </span>
                <Icon name="arrow-up-right" size={18} class="card__arrow" />
              </span>
              <span class="card__body">
                <span class="card__title">{c.title}</span>
                <span class="card__blurb">{c.blurb}</span>
              </span>
              <span class="sr-only"> — message the clinic on WhatsApp about this concern (opens in a new tab)</span>
            </a>
          </li>
        ))
      }

      <li class="cell cell--cta reveal" style="--i:1">
        <div class="cta">
          <div>
            <p class="cta__title">Not sure where to start?</p>
            <p class="cta__sub">Tell the clinic what you’re experiencing — they’ll point you to the next step.</p>
          </div>
          <a class="btn btn-primary btn-sm" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="conditions-cta">
            WhatsApp the clinic
            <Icon name="arrow-right" size={18} class="icon-arrow" />
          </a>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .relative {
    position: relative;
  }
  .head {
    display: grid;
    gap: 0.9rem;
    margin-bottom: clamp(24px, 3.5vw, 40px);
  }
  .head__title {
    display: grid;
    gap: 0.8rem;
  }
  .head__lead {
    max-width: 34rem;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cell {
    position: relative;
    display: flex;
  }
  /* Body-map landing: an orange ring pulses around the card for 1.2s (transform + opacity only) */
  .cell::after {
    content: '';
    position: absolute;
    inset: -4px;
    z-index: 2;
    border: 2px solid var(--color-cta);
    border-radius: 20px;
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cell.is-flash::after {
      animation: card-flash 1200ms ease-out both;
    }
  }
  /* Reduced motion: the same ring, held still for the same 1.2s */
  @media (prefers-reduced-motion: reduce) {
    .cell.is-flash::after {
      opacity: 1;
    }
  }
  @keyframes card-flash {
    0% {
      opacity: 0;
      transform: scale(0.97);
    }
    15% {
      opacity: 1;
      transform: scale(1);
    }
    40% {
      opacity: 0.35;
      transform: scale(1.03);
    }
    60% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.06);
    }
  }
  .cell--cta {
    grid-column: 1 / -1;
  }

  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    width: 100%;
    min-height: 116px;
    padding: 0.85rem 0.9rem 0.9rem;
    border-radius: 16px;
    border: 1px solid rgb(12 59 54 / 0.1);
    background: linear-gradient(145deg, rgb(255 255 255 / 0.82), rgb(250 248 242 / 0.66));
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.8) inset, 0 6px 16px -14px rgb(12 59 54 / 0.4);
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 250ms ease,
      border-color 250ms ease,
      box-shadow 250ms ease;
  }
  /* Hover (all inside ~260ms): a soft teal highlight travels once across the card, the icon tips a few
     degrees and the arrow slides out. The highlight snaps back off-card, so it only ever moves forward. */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 28%, rgb(15 118 110 / 0.11) 50%, transparent 72%);
    transform: translate3d(-110%, 0, 0);
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-4px);
    border-color: rgb(15 118 110 / 0.55);
    box-shadow:
      0 0 0 1px rgb(15 118 110 / 0.16),
      0 18px 28px -18px rgb(12 59 54 / 0.4);
  }
  .card:hover::before,
  .card:focus-visible::before {
    transform: translate3d(110%, 0, 0);
    transition: transform 250ms ease-out;
  }
  .card:active {
    transform: translateY(-1px);
  }

  .card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .card__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgb(15 118 110 / 0.1);
    color: var(--color-teal);
    transition:
      transform 250ms ease,
      background-color 250ms ease,
      color 250ms ease;
  }
  .card:hover .card__icon,
  .card:focus-visible .card__icon {
    background: var(--color-teal);
    color: #fff;
    transform: rotate(-4deg);
  }
  .card :global(.card__arrow) {
    color: rgb(12 59 54 / 0.4);
    transition:
      transform 250ms ease,
      color 250ms ease;
  }
  .card:hover :global(.card__arrow),
  .card:focus-visible :global(.card__arrow) {
    color: var(--color-teal);
    transform: translate(3px, -3px);
  }

  .card__body {
    display: grid;
    gap: 0.2rem;
  }
  .card__title {
    font: 400 1.0625rem/1.2 var(--font-serif);
    text-wrap: balance;
  }
  .card__blurb {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-ink) 68%, transparent);
  }

  /* Micro-CTA tile (warm sand) closes the grid */
  .cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1.1rem 1.1rem 1.15rem;
    border-radius: 16px;
    background: linear-gradient(135deg, #efe6d2, var(--color-sand));
    border: 1px solid rgb(12 59 54 / 0.1);
  }
  .cta__title {
    font: 400 1.3125rem/1.2 var(--font-serif);
    color: var(--color-pine);
  }
  .cta__sub {
    margin-top: 0.3rem;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }

  /* One column on phones: icon, title + blurb, arrow in a single row keeps 13 cards from becoming a very long scroll */
  @media (max-width: 639px) {
    .card {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'icon body arrow';
      align-items: center;
      column-gap: 0.9rem;
      min-height: 76px;
      padding: 0.8rem 1rem;
    }
    .card__top {
      display: contents;
    }
    .card__icon {
      grid-area: icon;
    }
    .card :global(.card__arrow) {
      grid-area: arrow;
      align-self: start;
    }
    .card__body {
      grid-area: body;
    }
    .card__blurb {
      -webkit-line-clamp: 2;
    }
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    .cell--cta {
      grid-column: 1 / -1;
    }
    .card {
      min-height: 124px;
      padding: 1rem;
    }
    .cta {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
      gap: 32px;
    }
    .head__title {
      grid-column: 1 / span 6;
    }
    .head__lead {
      grid-column: 8 / span 5;
      padding-bottom: 0.3rem;
    }
    .grid {
      gap: 16px;
    }
    .card__title {
      font-size: 1.125rem;
    }
  }

  @media (hover: none) {
    .card:hover {
      transform: none;
    }
  }
</style>
