---
import { conditions } from '../data/site';

// Each chip jumps to the condition card whose title matches `target` (case-insensitive).
const spots = [
  { key: 'neck', label: 'Neck', target: 'Neck Pain' },
  { key: 'shoulder', label: 'Shoulder', target: 'Shoulder Pain / Frozen Shoulder' },
  { key: 'back', label: 'Back', target: 'Back Pain' },
  { key: 'sciatica', label: 'Sciatica', target: 'Sciatica' },
  { key: 'knee', label: 'Knee', target: 'Knee Pain / Arthritis' },
  { key: 'sports', label: 'Sports', target: 'Sports Injuries' },
] as const;

// A chip must never point at a card that does not exist
for (const s of spots) {
  if (!conditions.some((c) => c.title.toLowerCase() === s.target.toLowerCase())) {
    throw new Error(`BodyMap: no condition titled "${s.target}"`);
  }
}
---

<div class="bm reveal" data-bodymap>
  <p class="bm__q" id="bm-q">Where does it hurt?</p>
  <ul class="bm__list" aria-labelledby="bm-q">
    {
      spots.map((s) => (
        <li>
          <button type="button" class="chip" data-bodymap-target={s.target} aria-label={`${s.label} — jump to the ${s.target} card`}>
            {s.label}
          </button>
        </li>
      ))
    }
  </ul>

  <p class="sr-only" role="status" aria-live="polite" data-bodymap-status></p>
</div>

<style>
  /* A quick-jump strip between hairlines: the question on the left, the six areas as plain serif links on the right */
  .bm {
    display: grid;
    gap: 0.5rem 2rem;
    align-items: center;
    margin: 0 0 clamp(16px, 2.2vw, 24px);
    padding-block: 0.2rem;
    border-block: 1px solid rgb(12 59 54 / 0.2);
  }
  .bm__q {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-teal);
  }
  .bm__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 0.85rem;
    border: 0;
    background: none;
    font: 400 1.375rem/1 var(--font-serif);
    color: var(--color-pine);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  /* The underline is a scaled bar (transform only); it draws in from the left on hover and focus */
  .chip::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 9px;
    height: 2px;
    background: var(--color-cta);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 280ms var(--ease-soft);
  }
  @media (hover: hover) {
    .chip:hover::after {
      transform: scaleX(1);
    }
  }
  .chip:focus-visible {
    outline: 3px solid var(--color-cta);
    outline-offset: -3px;
  }
  .chip:focus-visible::after {
    transform: scaleX(1);
  }
  .chip:active {
    color: var(--color-teal);
  }

  @media (min-width: 900px) {
    .bm {
      grid-template-columns: auto 1fr;
    }
  }
</style>
