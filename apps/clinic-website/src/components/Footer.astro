---
import Icon from './Icon.astro';
import { clinic, hours, links, nav } from '../data/site';

const footerNav = nav;
const year = new Date().getFullYear();
---

<footer class="footer curve on-dark">
  <div class="container-site">
    <div class="row">
      <div class="brand">
        <span class="mark" aria-hidden="true">{clinic.monogram}</span>
        <div>
          <p class="name">{clinic.name}</p>
          <p class="sub">Gomti Nagar, Lucknow</p>
        </div>
      </div>

      <nav class="links" aria-label="Footer">
        <ul>
          {footerNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>

      <div class="contact">
        <a class="phone" href={links.tel} data-track="phone_click" data-location="footer">{clinic.phone.display}</a>
        <a class="btn btn-primary btn-sm" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="footer">
          <Icon name="message-circle" size={18} /> WhatsApp
        </a>
      </div>
    </div>

    <div class="legal">
      <p>{hours.days} {hours.sessions.join(' & ')} · {hours.closed}</p>
      <p>© {year} {clinic.name}</p>
      <p class="credit">Website by FlowHQ</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    --surface: var(--color-ink);
    color: rgb(250 248 242 / 0.8);
    padding-block: calc(48px + var(--curve)) calc(40px + env(safe-area-inset-bottom, 0px));
  }
  .row {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(145deg, var(--color-teal), var(--color-pine));
    color: var(--color-ivory);
    font: 400 1.2rem/1 var(--font-serif);
  }
  .name {
    margin: 0;
    font: 400 1.3125rem/1.2 var(--font-serif);
    color: var(--color-ivory);
  }
  .sub {
    margin: 0.15rem 0 0;
    font-size: 0.875rem;
    color: rgb(250 248 242 / 0.6);
  }
  .links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.35rem 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgb(250 248 242 / 0.82);
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }
  .links a:hover {
    color: var(--color-sand);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .phone {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--color-ivory);
    text-decoration: none;
  }
  .phone:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    margin-top: 2.25rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgb(250 248 242 / 0.12);
    font-size: 0.8125rem;
    color: rgb(250 248 242 / 0.55);
  }
  .legal p {
    margin: 0;
  }
  /* Plain-text credit on its own quiet line */
  .credit {
    flex-basis: 100%;
    font-size: 0.75rem;
    color: rgb(250 248 242 / 0.4);
  }

  @media (min-width: 900px) {
    .row {
      grid-template-columns: 1.2fr 1.6fr auto;
      gap: 2.5rem;
    }
    .contact {
      justify-content: flex-end;
    }
  }
  /* The page has 76px of bottom padding for the fixed mobile bar; the footer's colour is painted into it */
  @media (max-width: 767px) {
    .footer {
      box-shadow: 0 calc(76px + env(safe-area-inset-bottom, 0px)) 0 0 var(--surface);
    }
  }
</style>
