---
import Icon from './Icon.astro';
import { clinic, hours, links, nav } from '../data/site';
import { landingPages } from '../data/landing';

const home = Astro.url.pathname === '/' ? '' : '/';
const footerNav = nav.map((n) => ({ ...n, href: `${home}${n.href}` }));
const year = new Date().getFullYear();
---

<footer class="footer curve on-dark">
  <div class="container-site">
    <div class="row">
      <div class="brand">
        <img class="logo" src="/brand/gkp-mark-cream.webp" alt="" width="94" height="46" loading="lazy" decoding="async" />
        <div>
          <p class="name">{clinic.name}</p>
          <p class="sub">Gomti Nagar, Lucknow</p>
        </div>
      </div>

      <nav class="links" aria-label="Footer">
        <ul>
          {footerNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>

      <div class="contact">
        <a class="phone" href={links.tel} data-track="phone_click" data-location="footer">{clinic.phone.display}</a>
        <a class="btn btn-primary btn-sm" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="footer">
          <Icon name="message-circle" size={18} /> WhatsApp
        </a>
      </div>
    </div>

    <nav class="services" aria-label="Physiotherapy in Lucknow">
      <p class="services__title">Physiotherapy in Lucknow</p>
      <ul>
        {landingPages.map((p) => <li><a href={`/${p.slug}/`}>{p.navLabel}</a></li>)}
      </ul>
    </nav>

    <div class="legal">
      <p>{hours.days} {hours.sessions.join(' & ')} · {hours.closed}</p>
      <p>© {year} {clinic.name}</p>
      <p class="credit">Website by FlowHQ</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    --surface: var(--color-ink);
    color: rgb(250 248 242 / 0.8);
    padding-block: calc(48px + var(--curve)) calc(40px + env(safe-area-inset-bottom, 0px));
  }
  .row {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .logo {
    display: block;
    height: 46px;
    width: auto;
  }
  .name {
    margin: 0;
    font: 400 1.3125rem/1.2 var(--font-serif);
    color: var(--color-ivory);
  }
  .sub {
    margin: 0.15rem 0 0;
    font-size: 0.875rem;
    color: rgb(250 248 242 / 0.6);
  }
  .links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.35rem 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgb(250 248 242 / 0.82);
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }
  .links a:hover {
    color: var(--color-sand);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .phone {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--color-ivory);
    text-decoration: none;
  }
  .phone:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .services {
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgb(250 248 242 / 0.12);
  }
  .services__title {
    margin: 0 0 0.3rem;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(250 248 242 / 0.55);
  }
  .services ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .services a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    color: rgb(250 248 242 / 0.72);
    text-decoration: none;
  }
  .services a:hover {
    color: var(--color-sand);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    margin-top: 2.25rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgb(250 248 242 / 0.12);
    font-size: 0.8125rem;
    color: rgb(250 248 242 / 0.55);
  }
  .legal p {
    margin: 0;
  }
  /* Plain-text credit on its own quiet line */
  .credit {
    flex-basis: 100%;
    font-size: 0.75rem;
    color: rgb(250 248 242 / 0.4);
  }

  @media (min-width: 900px) {
    .row {
      grid-template-columns: 1.2fr 1.6fr auto;
      gap: 2.5rem;
    }
    .contact {
      justify-content: flex-end;
    }
    /* Four links per line (4 + 3) instead of six and a lone "Visit" */
    .links ul {
      display: grid;
      grid-template-columns: repeat(4, max-content);
      gap: 0.4rem 1.6rem;
    }
  }
  /* The page has 76px of bottom padding for the fixed mobile bar; the footer's colour is painted into it */
  @media (max-width: 767px) {
    .footer {
      box-shadow: 0 calc(76px + env(safe-area-inset-bottom, 0px)) 0 0 var(--surface);
    }
  }
</style>
