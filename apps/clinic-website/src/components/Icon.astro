---
import { icons, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  /** Pass a label for meaningful icons; omit for decorative ones (hidden from assistive tech). */
  label?: string;
}

const { name, size = 20, strokeWidth = 2, class: className, label } = Astro.props;
const raw = icons[name];
// Keep the inner shapes of the Lucide SVG and re-wrap with our own attributes.
const inner = raw.slice(raw.indexOf('>', raw.indexOf('<svg')) + 1, raw.lastIndexOf('</svg>')).trim();
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={inner}
/>
