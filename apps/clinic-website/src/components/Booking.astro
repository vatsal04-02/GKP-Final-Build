---
import Depth from './Depth.astro';
import Icon from './Icon.astro';
import { clinic, hours, links, schedule } from '../data/site';
import { CONCERNS as concerns, SLOTS as slots } from '../lib/enquiry-shared.mjs';

/**
 * Booking *request* form. There is no calendar or payment: the request is posted to /api/enquiry (a server function that
 * forwards it to the clinic's CRM) and the clinic contacts the visitor to confirm a slot. If sending fails the visitor
 * can still send the same request on WhatsApp. Logic lives in src/scripts/booking.ts; the choices are shared with the API
 * in src/lib/enquiry-shared.mjs.
 */
const endpoint = import.meta.env.PUBLIC_ENQUIRY_ENDPOINT || '/api/enquiry';
---

<section id="book" class="section curve surface-tint" data-section data-ambient data-hide-sticky aria-labelledby="book-title">
  <Depth tone="sand" glow mirror drift={false} />

  <div class="container-site">
   <div class="panel reveal">
    <span class="panel__dots" aria-hidden="true"></span>
    <svg class="panel__arcs" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
      <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
        <circle cx="400" cy="0" r="170"></circle>
        <circle cx="400" cy="0" r="260"></circle>
        <circle cx="400" cy="0" r="350" stroke-dasharray="2 8"></circle>
      </g>
    </svg>

    <div class="grid">
    <header class="copy">
      <p class="eyebrow">Book your visit</p>
      <h2 id="book-title" class="h2">Book your visit.</h2>
      <p class="lead">Send a booking request — the clinic contacts you to confirm your slot.</p>
      <p class="copy__hours">
        <Icon name="clock" size={16} />
        <span>{hours.days} · {hours.sessions.join(' & ')} · {hours.closed}</span>
      </p>
    </header>

    <div class="card">
      <form
        id="book-form"
        class="book"
        novalidate
        data-book-form
        data-wa={clinic.phone.whatsapp}
        data-endpoint={endpoint}
        data-schedule={JSON.stringify(schedule)}
        aria-describedby="book-note"
      >
        <!-- Honeypot: invisible to people, bots fill it in. The server stores nothing when it is filled. -->
        <div class="hp" aria-hidden="true">
          <label for="book-website">Leave this field empty</label>
          <input id="book-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="row">
          <div class="field" data-field="name">
            <label for="book-name">Name</label>
            <input id="book-name" name="name" type="text" autocomplete="name" maxlength="60" required aria-describedby="book-name-err" />
            <p class="err" id="book-name-err" hidden>Please enter your name.</p>
          </div>

          <div class="field" data-field="phone">
            <label for="book-phone">Phone</label>
            <div class="phone">
              <span class="phone__cc" aria-hidden="true">+91</span>
              <input
                id="book-phone"
                name="phone"
                type="tel"
                inputmode="numeric"
                autocomplete="tel-national"
                placeholder="10-digit mobile number"
                required
                aria-describedby="book-phone-err"
              />
            </div>
            <p class="err" id="book-phone-err" hidden>Enter a 10-digit phone number.</p>
          </div>
        </div>

        <div class="row">
          <div class="field" data-field="concern">
            <label for="book-concern">Concern</label>
            <select id="book-concern" name="concern" required aria-describedby="book-concern-err">
              <option value="" selected disabled>Choose your concern</option>
              {concerns.map((c) => <option value={c}>{c}</option>)}
            </select>
            <p class="err" id="book-concern-err" hidden>Please choose a concern.</p>
          </div>

          <fieldset class="field" data-field="visit">
            <legend>Visit type</legend>
            <div class="chips chips--2">
              <label class="chip">
                <input type="radio" name="visit" value="At the clinic" checked />
                <span>At the clinic</span>
              </label>
              <label class="chip">
                <input type="radio" name="visit" value="Home visit" />
                <span>Home visit</span>
              </label>
            </div>
          </fieldset>
        </div>

        <fieldset class="field" data-field="day">
          <legend>Preferred day</legend>
          <div class="chips chips--days" data-days></div>
          <!-- Cloned by booking.ts once it knows today's date in clinic time (scoped styles travel with the template) -->
          <template data-day-chip>
            <label class="chip">
              <input type="radio" name="day" />
              <span></span>
            </label>
          </template>
          <noscript><p class="err">This form needs JavaScript — please use WhatsApp or call the clinic instead.</p></noscript>
          <p class="err" id="book-day-err" hidden>Please pick a day.</p>
        </fieldset>

        <fieldset class="field" data-field="slot">
          <legend>Time</legend>
          <div class="chips chips--2">
            {
              slots.map((s) => (
                <label class="chip">
                  <input type="radio" name="slot" value={s} />
                  <span>{s.split(' ')[0]} <em class="nw">{s.split(' ').slice(1).join(' ')}</em></span>
                </label>
              ))
            }
          </div>
          <p class="err" id="book-slot-err" hidden>Please pick a time.</p>
        </fieldset>

        <!-- DRAFT WORDING: needs the clinic's approval before it is published (see PRIVACY_DRAFT.md). The version string
             CONSENT_VERSION in src/lib/enquiry-shared.mjs must change whenever this text changes. -->
        <div class="consent">
          <label class="consent__label">
            <input type="checkbox" name="consent_whatsapp" id="book-consent" />
            <span>
              WhatsApp is optional. Tick this box if you are happy for the clinic to message you on WhatsApp about this request and your
              care. Leave it unticked and the clinic can still handle your request, for example by phone.
            </span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-block cta" data-book-submit>
          <span data-book-label>Send request</span>
          <Icon name="arrow-right" size={18} class="icon-arrow" />
        </button>

        <p class="note" id="book-note">
          Your name, phone number and request details are sent to Geeta Krishna Physiotherapy so the clinic can respond to your
          request. This is a request only: your visit is not confirmed until the clinic contacts you.
        </p>
        <p class="status" data-book-status role="status" aria-live="polite" hidden></p>
        <p class="fallback" data-book-fallback hidden>
          <button type="button" class="btn btn-block fallback__btn" data-book-wa>Send this request on WhatsApp instead</button>
        </p>
        <p class="alt">Prefer to talk? <a href={links.tel} data-track="phone_click" data-location="booking-form">Call the clinic</a></p>
      </form>
    </div>
    </div>
   </div>
  </div>
</section>

<style>
  /* ---- The action zone: one deep-teal panel on a pale band, cream type, an orange send button ---- */
  .panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(1.25rem, 0.5rem + 3.6vw, 3.75rem);
    border-radius: clamp(24px, 3vw, 36px);
    color: var(--color-ivory);
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(45 156 146 / 0.3), transparent 62%),
      radial-gradient(60% 80% at 0% 100%, rgb(233 223 201 / 0.07), transparent 60%),
      linear-gradient(160deg, #0f4a44 0%, var(--color-pine) 52%, #082e2a 100%);
    box-shadow:
      0 1px 0 rgb(250 248 242 / 0.12) inset,
      0 44px 80px -44px rgb(12 59 54 / 0.85);
  }
  .panel__dots {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(circle, rgb(250 248 242 / 0.5) 1px, transparent 1.4px);
    background-size: 22px 22px;
    opacity: 0.14;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 90% 10%, #000 0%, transparent 100%);
    mask-image: radial-gradient(ellipse 60% 70% at 90% 10%, #000 0%, transparent 100%);
  }
  .panel__arcs {
    position: absolute;
    top: 0;
    right: 0;
    z-index: -1;
    width: min(54%, 460px);
    aspect-ratio: 1;
    color: rgb(233 223 201 / 0.14);
  }

  .grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* an implicit auto column would grow to the form's widest content */
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  .copy {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
  }
  .copy .eyebrow {
    color: var(--color-sand);
  }
  .copy .h2 {
    color: var(--color-ivory);
  }
  .copy .lead {
    color: rgb(250 248 242 / 0.86);
  }
  .copy__hours {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0.4rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgb(250 248 242 / 0.78);
  }
  .copy__hours :global(.icon) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--teal-light);
  }

  /* ---- Form ---- */
  .card {
    min-width: 0;
    padding: clamp(1rem, 0.5rem + 2vw, 1.9rem);
    border: 1px solid rgb(250 248 242 / 0.16);
    border-radius: 24px;
    background: linear-gradient(145deg, rgb(250 248 242 / 0.1), rgb(250 248 242 / 0.04));
    box-shadow: 0 1px 0 rgb(250 248 242 / 0.1) inset;
  }
  .book {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.15rem;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.15rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .field label,
  .field legend {
    padding: 0;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--color-sand);
  }
  .field input,
  .field select {
    width: 100%;
    min-width: 0;
    min-height: 52px;
    padding: 0 0.95rem;
    border: 1.5px solid transparent;
    border-radius: 12px;
    background: var(--color-ivory);
    color: var(--color-ink);
    font: 600 1rem/1.2 var(--font-sans); /* 16px: stops iOS from zooming the page on focus */
    transition:
      border-color var(--dur-normal) ease,
      box-shadow var(--dur-normal) ease;
  }
  .field input::placeholder {
    color: color-mix(in srgb, var(--color-ink) 52%, transparent);
    font-weight: 500;
  }
  .field select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 2.6rem;
    text-overflow: ellipsis;
    cursor: pointer;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%230C3B36' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='m6 9 6 6 6-6'/></svg>");
    background-repeat: no-repeat;
    background-position: right 0.9rem center;
  }
  .field input:hover,
  .field select:hover {
    border-color: rgb(233 223 201 / 0.8);
  }
  .field input:focus-visible,
  .field select:focus-visible {
    outline: none;
    border-color: var(--color-sand);
    box-shadow: 0 0 0 3px rgb(233 223 201 / 0.45);
  }
  .field [aria-invalid='true'] {
    border-color: #ff8f82;
  }

  /* +91 prefix sits inside the same box as the number */
  .phone {
    display: flex;
    align-items: stretch;
    min-height: 52px;
    border: 1.5px solid transparent;
    border-radius: 12px;
    background: var(--color-ivory);
    overflow: hidden;
    transition:
      border-color var(--dur-normal) ease,
      box-shadow var(--dur-normal) ease;
  }
  .phone:hover {
    border-color: rgb(233 223 201 / 0.8);
  }
  .phone:focus-within {
    border-color: var(--color-sand);
    box-shadow: 0 0 0 3px rgb(233 223 201 / 0.45);
  }
  .phone__cc {
    display: grid;
    place-items: center;
    padding: 0 0.85rem;
    border-right: 1.5px solid rgb(12 59 54 / 0.14);
    background: rgb(233 223 201 / 0.7);
    font-weight: 800;
    color: var(--color-pine);
  }
  .phone input {
    flex: 1;
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .phone input:focus-visible {
    box-shadow: none;
  }
  .field:has([aria-invalid='true']) .phone {
    border-color: #ff8f82;
  }

  /* ---- Chips (radio buttons that look like pills) ---- */
  .chips {
    display: grid;
    gap: 0.5rem;
  }
  .chips--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .chips--days {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    min-height: calc(48px * 2 + 0.5rem); /* two rows reserved so the page doesn't jump when the dates appear */
    align-content: start;
  }
  .chip {
    position: relative;
    display: block;
    min-width: 0;
  }
  .chip input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .chip > span {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: 0.3em;
    min-height: 48px;
    padding: 0.4rem 0.7rem;
    border: 1.5px solid rgb(250 248 242 / 0.3);
    border-radius: 12px;
    background: rgb(250 248 242 / 0.06);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    color: var(--color-ivory);
    transition:
      transform 120ms ease,
      background-color var(--dur-normal) ease,
      border-color var(--dur-normal) ease,
      color var(--dur-normal) ease,
      box-shadow var(--dur-normal) ease;
  }
  .chip:hover > span {
    border-color: rgb(233 223 201 / 0.75);
    background: rgb(250 248 242 / 0.12);
  }
  .chip:active > span {
    transform: scale(0.96);
  }
  .chip input:checked + span {
    border-color: var(--color-sand);
    background: var(--color-sand);
    color: var(--color-pine);
  }
  .chip input:focus-visible + span {
    box-shadow: 0 0 0 3px rgb(233 223 201 / 0.5);
  }

  /* keeps "9 AM–1 PM" together so a chip breaks after "Morning", not in the middle of the hours */
  .nw {
    font-style: normal;
    white-space: nowrap;
  }

  /* The send button is the point of the whole section */
  .cta {
    min-height: 58px;
    padding-inline: 0.9rem;
    gap: 0.5rem;
    font-size: 1.17rem; /* phones: 18.7px bold keeps white-on-orange a "large text" pass (3.55:1); the label and icons still fit the full-width button */
    box-shadow: 0 18px 36px -14px rgb(234 88 12 / 0.75);
  }
  @media (min-width: 480px) {
    .cta {
      padding-inline: 1.6rem;
      gap: 0.65rem;
      font-size: 1.1875rem;
    }
  }

  /* ---- Messages ---- */
  .err {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    color: #ffb4a9;
  }
  .err[hidden] {
    display: none;
  }
  .note {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(250 248 242 / 0.7);
  }
  .status {
    margin: 0;
    padding: 0.7rem 0.9rem;
    border-radius: 12px;
    background: rgb(250 248 242 / 0.12);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-ivory);
  }
  .status[hidden] {
    display: none;
  }
  .status[data-state='error'] {
    background: rgb(255 143 130 / 0.2);
  }
  .alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.35rem;
    margin: 0;
    font-size: 0.9375rem;
    color: rgb(250 248 242 / 0.85);
  }
  .alt a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--color-ivory);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgb(233 223 201 / 0.6);
  }

  /* Honeypot: off-screen (not display:none, which some bots skip) */
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .consent__label {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgb(250 248 242 / 0.88);
    cursor: pointer;
  }
  .consent__label input {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.1rem;
    accent-color: var(--color-sand);
  }
  .consent__label input:focus-visible {
    outline: 3px solid rgb(233 223 201 / 0.6);
    outline-offset: 2px;
  }
  .fallback {
    margin: 0;
  }
  .fallback[hidden] {
    display: none;
  }
  .fallback__btn {
    color: var(--color-ivory);
    background: transparent;
    border: 1.5px solid rgb(250 248 242 / 0.5);
  }
  .cta[disabled] {
    opacity: 0.7;
    cursor: progress;
  }

  /* Phones: the panel runs a little wider than the page gutters, to give the form room */
  @media (max-width: 639px) {
    .panel {
      margin-inline: -8px;
    }
  }
  @media (min-width: 640px) {
    .chips--days {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      min-height: 48px;
    }
  }
  @media (min-width: 768px) {
    .row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 40px;
    }
    .copy {
      grid-column: 1 / span 5;
      align-self: center; /* the heading sits level with the middle of the form, not stranded at its top */
    }
    .card {
      grid-column: 6 / span 7;
    }
  }
</style>
