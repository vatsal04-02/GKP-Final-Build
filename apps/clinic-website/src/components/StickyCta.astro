---
import Icon from './Icon.astro';
import { links } from '../data/site';
---

<!-- ≤768px: a fixed bottom bar (Call + WhatsApp the Clinic) and no floating bubble.
     ≥769px: the floating round button. Appears once the hero CTA has scrolled away (design.md §22). -->
<div class="sticky-cta" data-sticky-cta>
  <div class="bar">
    <a class="call btn btn-outline" href={links.tel} data-track="phone_click" data-location="sticky">
      <Icon name="phone" size={18} />
      Call
    </a>
    <a class="wa btn btn-primary" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="sticky">
      <Icon name="message-circle" size={19} />
      WhatsApp the Clinic
    </a>
  </div>

  <a class="fab" href={links.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp the Clinic" data-track="whatsapp_click" data-location="floating">
    <Icon name="message-circle" size={26} />
    <span class="fab__label" aria-hidden="true">WhatsApp the Clinic</span>
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    z-index: 40;
    inset: auto 0 0 0;
    padding: 0;
    pointer-events: none;
    transition:
      transform 420ms var(--ease-soft),
      opacity 320ms ease;
  }
  /* Hidden only when JS can reveal it again */
  :global(.js) .sticky-cta:not(.is-visible) {
    transform: translate3d(0, 130%, 0);
    opacity: 0;
  }
  .sticky-cta > * {
    pointer-events: auto;
  }

  /* ---- Mobile bar: 60px of buttons + the home-indicator inset, flush with the bottom edge ---- */
  .bar {
    display: grid;
    grid-template-columns: 1fr 1fr; /* two equal buttons */
    gap: 8px;
    width: 100%;
    height: calc(60px + env(safe-area-inset-bottom, 0px));
    padding: 4px 12px env(safe-area-inset-bottom, 0px);
    border-top: 1px solid rgb(12 59 54 / 0.14);
    background: rgb(250 248 242 / 0.97);
    box-shadow: 0 -10px 26px -18px rgb(12 59 54 / 0.45);
  }
  .bar .btn {
    width: 100%;
    min-width: 0;
    height: 52px;
    min-height: 52px;
    padding-inline: 0.5rem;
    gap: 0.45rem;
  }
  .call {
    background: rgb(255 255 255 / 0.6);
  }
  /* The label stays at the 18.7px the contrast rule needs, so "WhatsApp the Clinic" wraps to two balanced lines
     inside its half of the bar instead of shrinking */
  .wa {
    white-space: normal;
    text-align: center;
    line-height: 1.1;
    text-wrap: balance;
  }
  .wa :global(.icon) {
    display: none;
  }
  @media (max-width: 349px) {
    .bar .btn :global(.icon) {
      display: none;
    }
  }

  .fab {
    display: none;
  }

  @media (min-width: 769px) {
    .sticky-cta {
      inset: auto 28px 28px auto;
    }
    :global(.js) .sticky-cta:not(.is-visible) {
      transform: translate3d(0, 24px, 0) scale(0.9);
    }
    .bar {
      display: none;
    }
    .fab {
      position: relative;
      display: grid;
      place-items: center;
      width: 62px;
      height: 62px;
      border-radius: 50%;
      background: var(--color-cta);
      color: #fff;
      text-decoration: none;
      box-shadow:
        0 18px 30px -12px rgb(234 88 12 / 0.75),
        inset 0 1px 0 rgb(255 255 255 / 0.3);
      transition:
        transform var(--dur-normal) var(--ease-soft),
        background-color var(--dur-normal) ease;
    }
    .fab:hover {
      transform: translateY(-3px);
      background: #d94e09;
    }
    .fab:active {
      transform: scale(0.96);
    }
    .fab__label {
      position: absolute;
      right: calc(100% + 12px);
      top: 50%;
      padding: 0.5rem 0.9rem;
      border-radius: 10px;
      background: var(--color-pine);
      color: var(--color-ivory);
      font-size: 0.875rem;
      font-weight: 700;
      white-space: nowrap;
      opacity: 0;
      transform: translate3d(8px, -50%, 0);
      pointer-events: none;
      transition:
        opacity var(--dur-normal) ease,
        transform var(--dur-normal) var(--ease-soft);
    }
    .fab:hover .fab__label,
    .fab:focus-visible .fab__label {
      opacity: 1;
      transform: translate3d(0, -50%, 0);
    }
  }
</style>
