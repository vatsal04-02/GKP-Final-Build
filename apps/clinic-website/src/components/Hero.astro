---
import ClinicImage from './ClinicImage.astro';
import Icon from './Icon.astro';
import { clinic, hours, links, schedule } from '../data/site';
// Looping background (5s, audio stripped). Phones get a 4:5 crop of the same shot around the entrance, so they
// download half the pixels and the people stay in frame. Both load after the page, see scripts/hero-video.ts.
import loopDesktop from '../assets/video/hero-loop.mp4?url';
import loopPhone from '../assets/video/hero-loop-m.mp4?url';

// Server-rendered fallback for the live pill (no JS / before hydration): the plain hours.
const fallback = `${hours.days} · ${hours.sessions.join(' · ')}`;
---

<section id="top" class="hero" data-section data-ambient data-hero aria-labelledby="hero-title">
  <!-- The picture and the video share one frame. The first frame of the loop is the poster, so the video
       takes over without a jump; reduced-motion, data-saver and failed playback simply keep the poster. -->
  <div class="hero__media" data-hero-media aria-hidden="true">
    <ClinicImage photo="hero-poster" alt="" sizes="(max-width: 639px) 800px, 100vw" priority class="hero__poster">
      <span class="hero__poster-fallback"></span>
    </ClinicImage>
    <video
      class="hero__video"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      tabindex="-1"
      data-hero-video
      data-src={loopDesktop}
      data-src-phone={loopPhone}></video>
    <span class="hero__scrim"></span>
  </div>

  <button type="button" class="hero__pause" data-hero-pause aria-pressed="false" aria-label="Pause the background video" hidden>
    <Icon name="pause" size={18} class="i-pause" />
    <Icon name="play" size={18} class="i-play" />
  </button>

  <div class="container-site hero__grid">
    <div class="hero__copy">
      <p class="eyebrow rise" style="--d:0ms">Local Physiotherapy • Gomti Nagar</p>

      <h1 id="hero-title" class="hero__title rise" style="--d:120ms">
        Physiotherapy that puts an <em class="accent-italic">expiry date</em> on your pain.
      </h1>

      <p class="hero__lead rise" style="--d:240ms">Two MPT doctors. One clear plan. Zero guesswork — in Gomti Nagar, Lucknow.</p>

      <p class="hero__hi rise" style="--d:300ms" lang="hi">दर्द से राहत, सही इलाज के साथ।</p>

      <div id="hero-cta" class="hero__cta rise" style="--d:360ms" data-hero-cta>
        <a class="btn btn-primary btn-glow" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="hero">
          <Icon name="message-circle" size={20} />
          WhatsApp the Clinic
          <Icon name="arrow-right" size={18} class="icon-arrow" />
        </a>
        <a class="btn btn-glass" href={links.tel} data-track="phone_click" data-location="hero">
          <Icon name="phone" size={18} />
          Call the Clinic
        </a>
      </div>

      <div class="badges rise" style="--d:480ms">
        <div class="rating">
          <span class="stars" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={15} class="star" />)}
          </span>
          <span class="rating__text">
            <strong data-live-rating>{clinic.rating.value}</strong> · <span data-live-count>{clinic.rating.count}</span> Google reviews
          </span>
          <span class="sr-only" data-live-text="Rated {rating} out of 5 stars from {count} Google reviews">Rated {clinic.rating.value} out of 5 stars from {clinic.rating.count} Google reviews</span>
        </div>

        <!-- Live status, computed in the browser against clinic time (IST) -->
        <p class="status" data-open-status data-schedule={JSON.stringify(schedule)}>
          <span class="status__dot" aria-hidden="true"></span>
          <span data-status-text>{fallback}</span>
        </p>
      </div>
    </div>

    <!-- Large screens only: the hours and the place, floating quietly at the lower right -->
    <div class="hours-card rise" style="--d:760ms">
      <p class="hours-card__label"><Icon name="clock" size={13} /> Clinic Hours</p>
      <p class="hours-card__main">{hours.days} · {hours.sessions[0]}</p>
      <p class="hours-card__sub">{hours.sessions[1]} · {hours.closed}</p>
      <p class="hours-card__place"><Icon name="map-pin" size={13} /> Viram Khand, Gomti Nagar</p>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Phones: the picture is a band across the top (4:5 crop) and the words sit beneath it */
    --band: 112.5vw;
    --lap: clamp(64px, 18vw, 96px); /* how far the headline climbs into the foot of the band */
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: var(--color-ivory);
    background:
      radial-gradient(90% 50% at 85% 62%, rgb(45 156 146 / 0.16), transparent 70%),
      var(--color-pine);
    /* room under the content for the dome of the trust band that rises over the foot of the hero */
    padding-top: calc(var(--band) - var(--lap));
    padding-bottom: calc(var(--curve) + 28px);
  }

  /* ---- Picture + video ---- */
  .hero__media {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: -1;
    aspect-ratio: 8 / 9; /* = the phone crop, so poster and video frame the same way */
    overflow: hidden;
    background: var(--color-pine);
  }
  .hero__media :global(.hero__poster),
  .hero__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The poster is the full 16:9 frame; this window is the same one the phone crop was cut from */
    object-position: 83.7% 50%;
    filter: none; /* the warm photo grade is for photographs; the video is left as shot */
  }
  .hero__media :global(picture) {
    display: contents;
  }
  .hero__video {
    object-position: 50% 50%; /* the phone file is already cropped */
    opacity: 0;
    transition: opacity 900ms ease;
  }
  .hero__media.is-playing .hero__video {
    opacity: 1;
  }
  .hero__poster-fallback {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #14574f, var(--color-pine));
  }

  /* Phones: the band melts into the pine below it, and a soft shade keeps the header legible on bright walls */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(7 33 30 / 0.76) 0, rgb(7 33 30 / 0.66) 72px, rgb(7 33 30 / 0.24) 150px, transparent 240px),
      linear-gradient(180deg, transparent 52%, rgb(12 59 54 / 0.75) 82%, var(--color-pine) 100%);
  }

  /* ---- Pause control (WCAG 2.2.2): only shown once the video is actually playing ---- */
  .hero__pause {
    position: absolute;
    z-index: 3;
    top: calc(var(--header-h) + 6px);
    right: 14px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(250 248 242 / 0.32);
    border-radius: 50%;
    background: rgb(12 59 54 / 0.5);
    color: var(--color-ivory);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--dur-normal) ease,
      transform var(--dur-fast) var(--ease-soft);
  }
  .hero__pause[hidden] {
    display: none;
  }
  .hero__pause:hover {
    background: rgb(12 59 54 / 0.78);
  }
  .hero__pause:active {
    transform: scale(0.94);
  }
  .hero__pause :global(.i-play),
  .hero__pause[aria-pressed='true'] :global(.i-pause) {
    display: none;
  }
  .hero__pause[aria-pressed='true'] :global(.i-play) {
    display: block;
  }

  /* ---- Words ---- */
  .hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-shadow: 0 1px 26px rgb(7 33 30 / 0.6), 0 0 2px rgb(7 33 30 / 0.35);
  }
  .eyebrow {
    color: var(--color-sand);
  }
  .hero__title {
    max-width: 14ch;
    margin: 0.8rem 0 0;
    font: 400 clamp(2.125rem, 1.55rem + 2.7vw, 2.75rem) / 1.06 var(--font-serif);
    letter-spacing: -0.016em;
    color: var(--color-ivory);
    text-wrap: balance;
  }
  .hero__title :global(.accent-italic) {
    color: var(--color-sand);
  }
  .hero__lead {
    max-width: 29rem;
    margin: 1.05rem 0 0;
    font-size: var(--lead-fs);
    line-height: 1.6;
    color: rgb(250 248 242 / 0.9);
  }
  /* Devanagari line under the subtext: serif italic, 90% of the subtext size */
  .hero__hi {
    margin: 0.5rem 0 0;
    font-family: 'Tiro Devanagari Hindi', 'Noto Serif Devanagari', 'Kohinoor Devanagari', var(--font-serif), serif;
    font-style: italic;
    font-weight: 400;
    font-size: calc(var(--lead-fs) * 0.9);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-teal) 38%, white);
  }
  .hero__cta {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: 100%;
    margin-top: 1.5rem;
    text-shadow: none;
  }
  .hero__cta .btn {
    width: 100%;
  }
  /* The ghost button needs a little body of its own to stay legible over a moving picture */
  .hero__cta :global(.btn-glass) {
    --btn-bg: rgb(12 59 54 / 0.58);
    --btn-border: rgb(250 248 242 / 0.4);
  }
  .hero__cta :global(.btn-glass:hover) {
    --btn-bg: rgb(12 59 54 / 0.8);
    --btn-border: rgb(250 248 242 / 0.6);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.1rem;
    text-shadow: none;
  }
  /* Dark chips (no blur: a blur over a playing video would be redrawn every frame) */
  .rating,
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.5rem 0.95rem 0.5rem 0.8rem;
    border: 1px solid rgb(250 248 242 / 0.2);
    border-radius: 999px;
    background: rgb(12 59 54 / 0.62);
    font-size: 0.8125rem;
    line-height: 1.2;
    color: var(--color-ivory);
  }
  .stars {
    display: inline-flex;
    gap: 2px;
    color: #e0ac45;
  }
  .stars :global(.star) {
    fill: currentColor;
    stroke-width: 1.5;
  }
  .rating strong {
    font: 400 1.1875rem/1 var(--font-serif);
  }
  .status {
    font-weight: 600;
  }
  .status__dot {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(250 248 242 / 0.5);
    box-shadow: 0 0 0 3px rgb(250 248 242 / 0.14);
    transition: background-color var(--dur-normal) ease, box-shadow var(--dur-normal) ease;
  }
  .status[data-state='open'] .status__dot {
    background: #5fd6c6;
    box-shadow: 0 0 0 3px rgb(95 214 198 / 0.28);
  }

  /* Hours card: large screens only */
  .hours-card {
    display: none;
  }

  /* ---- Tablet: the band widens to the 16:9 frame, still above the words ---- */
  @media (min-width: 640px) {
    .hero {
      --band: 56.25vw;
      --lap: 72px;
    }
    .hero__media {
      aspect-ratio: 16 / 9;
    }
    .hero__media :global(.hero__poster),
    .hero__video {
      object-position: 85% 50%;
    }
    .hero__scrim {
      background:
        linear-gradient(180deg, rgb(7 33 30 / 0.76) 0, rgb(7 33 30 / 0.66) 72px, rgb(7 33 30 / 0.24) 150px, transparent 240px),
        linear-gradient(180deg, transparent 56%, rgb(12 59 54 / 0.75) 84%, var(--color-pine) 100%);
    }
    .hero__title {
      max-width: 17ch;
      font-size: clamp(2.75rem, 2.1rem + 2vw, 3.5rem);
    }
    .hero__cta {
      flex-direction: row;
      width: auto;
    }
    .hero__cta .btn {
      width: auto;
    }
    .hero__pause {
      right: 20px;
    }
  }

  /* ---- Tablet landscape / small tablets: the hours card takes the right-hand column ---- */
  @media (min-width: 768px) {
    .hero__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: 28px;
    }
    .hours-card {
      display: block;
      padding: 0.85rem 1.1rem 0.9rem;
      border: 1px solid rgb(250 248 242 / 0.2);
      border-radius: 18px;
      background: rgb(12 59 54 / 0.66);
      line-height: 1.35;
    }
    .hours-card p {
      margin: 0;
    }
    .hours-card__label {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 0.3rem !important;
      font-size: 0.6875rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--teal-light);
    }
    .hours-card__main {
      font-size: 0.9375rem;
      font-weight: 700;
      color: var(--color-ivory);
    }
    .hours-card__sub {
      font-size: 0.8125rem;
      color: rgb(250 248 242 / 0.74);
    }
    .hours-card__place {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      margin-top: 0.55rem !important;
      padding-top: 0.55rem;
      border-top: 1px solid rgb(250 248 242 / 0.16);
      font-size: 0.8125rem;
      font-weight: 600;
      color: rgb(250 248 242 / 0.86);
    }
  }

  /* ---- Large screens: full-bleed, the words on a soft shade at the left ---- */
  @media (min-width: 1024px) {
    .hero {
      display: grid;
      align-items: center;
      min-height: clamp(620px, calc(100svh - 56px), 920px);
      padding-top: calc(var(--header-h) + 28px);
      padding-bottom: calc(var(--curve) + 48px);
    }
    .hero__media {
      inset: 0;
      aspect-ratio: auto;
    }
    .hero__media :global(.hero__poster),
    .hero__video {
      object-position: 80% 62%;
    }
    .hero__scrim {
      /* --edge = where the page content starts (the container is centred above 1280px) */
      --edge: max(0px, calc((100vw - 1280px) / 2));
      background:
        linear-gradient(
          90deg,
          rgb(7 33 30 / 0.55) 0,
          rgb(7 33 30 / 0.88) calc(var(--edge) + 40px),
          rgb(7 33 30 / 0.82) calc(var(--edge) + 400px),
          rgb(7 33 30 / 0.62) calc(var(--edge) + 640px),
          rgb(7 33 30 / 0.22) calc(var(--edge) + 860px),
          transparent calc(var(--edge) + 1100px)
        ),
        linear-gradient(180deg, rgb(7 33 30 / 0.76) 0, rgb(7 33 30 / 0.66) 72px, rgb(7 33 30 / 0.24) 150px, transparent 240px),
        linear-gradient(0deg, rgb(7 33 30 / 0.5) 0, rgb(7 33 30 / 0) 26%);
    }
    .hero__grid {
      display: block;
      width: 100%;
    }
    /* On narrower desktops the people in the video sit a little right of centre: the words give way before they do */
    .hero__copy {
      max-width: min(46rem, 43vw);
    }
    .hero__title {
      max-width: 16ch;
      margin-top: 1rem;
      font-size: clamp(3.25rem, 1.6rem + 2.9vw, 4.75rem);
      line-height: 1.04;
    }
    .hero__lead {
      max-width: 30rem;
      margin-top: 1.3rem;
    }
    .hero__cta {
      margin-top: 1.8rem;
    }
    .badges {
      margin-top: 1.4rem;
    }
    .rating,
    .status {
      font-size: 0.875rem;
    }
    .hero__pause {
      right: max(32px, calc((100vw - 1280px) / 2 + 32px));
    }
    .hours-card {
      position: absolute;
      z-index: 2;
      right: max(32px, calc((100vw - 1280px) / 2 + 32px));
      bottom: calc(var(--curve) + 30px);
      text-shadow: none;
    }
  }
</style>
