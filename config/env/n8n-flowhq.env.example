# FlowHQ workflow settings for n8n. Same names as in the root .env.example (docker-compose.yml passes exactly these to the n8n container).
# Copy the lines you need into the SERVER's .env (never into git) and replace every <...>. N8N_BLOCK_ENV_ACCESS_IN_NODE=false is set in docker-compose.yml.
#
# REQUIRED (the workflow stops with a message naming the variable when one is missing)
FLOWHQ_REGISTRY_DOC_ID=<Grist document id of the Agency Registry (table Clinics)>
FLOWHQ_META_APP_SECRET=<Meta app secret, at least 16 characters>
FLOWHQ_META_VERIFY_TOKEN=<any long random string, at least 16 characters, also entered in Meta's webhook setup>
FLOWHQ_CAL_WEBHOOK_SECRET=<the Cal.com webhook secret, at least 16 characters>
# REQUIRED while FLOWHQ_WA_SEND_MODE=allowlist
FLOWHQ_WA_ALLOWLIST=<comma separated numbers allowed to receive messages while testing>
#
# SAFE DEFAULTS for a first run: nothing is sent, no e-mail, no external AI
FLOWHQ_WA_SEND_MODE=off                 # off | allowlist | live
FLOWHQ_ALERT_EMAIL_TO=                  # empty = no staff e-mail
FLOWHQ_AI_EXTERNAL_ENABLED=false        # true only after the clinic approved sending (masked) patient text to the AI provider
FLOWHQ_AI_MODEL=openai/gpt-4o-mini
FLOWHQ_AI_MAX_REPLIES_PER_HOUR=6
#
# Website enquiries (W1)
FLOWHQ_W1_REQUIRE_CONSENT=true          # false = store an enquiry even when the WhatsApp box is unticked (consent flag stays false); see docs/INSTALL.md
FLOWHQ_W2_IMPLIED_CONSENT=true
#
# Defaults (rarely changed)
FLOWHQ_GRIST_URL=http://grist:8484
FLOWHQ_DEFAULT_COUNTRY_CODE=91
FLOWHQ_WA_GRAPH_VERSION=v23.0
FLOWHQ_WA_TEMPLATE_LANGUAGE=en
FLOWHQ_WA_ALLOW_HELLO_WORLD=false       # true only for a smoke test on Meta's test number
FLOWHQ_CAL_MAX_AGE_HOURS=24
FLOWHQ_TELEGRAM_CHAT_ID=
FLOWHQ_TEST_PHONE=
FLOWHQ_EMAIL_FROM=
FLOWHQ_EMAIL_PATIENT_ACK=false
