# Copy to .env and fill in. NEVER commit .env to git.

# --- Domains (create ALL FOUR DNS A records, pointing at the server IP, before the first start) ---
N8N_DOMAIN=n8n.youragency.in           # public: only n8n's /webhook/* (website form, WhatsApp, booking events)
N8N_ADMIN_DOMAIN=n8n-admin.youragency.in  # the n8n editor: reachable only from ADMIN_ALLOW_CIDR
GRIST_DOMAIN=crm.youragency.in         # the CRM database (Google sign-in)
FLOWHQ_DOMAIN=app.youragency.in        # the staff app
# Who may open the n8n editor: your own IP address(es), space separated, e.g. 203.0.113.7/32.
# Easiest: log in to the server over SSH and run  ./scripts/allow-admin-ip.sh   (it uses the address you connected from).
ADMIN_ALLOW_CIDR=127.0.0.1/32
# For the controlled test ONLY (docs/DEPLOY_HOSTINGER.md step 8): set to /webhook-test/* so the website can reach n8n's test webhook,
# then `docker compose up -d caddy`. Remove it (leave empty) again afterwards.
N8N_EXTRA_WEBHOOK_PATH=
# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@youragency.in

# --- Versions (pin exact versions before your first client goes live) ---
N8N_VERSION=2.43.5          # the version the workflow was tested on: change only after re-testing
GRIST_VERSION=1.7.20

# --- Backups (scripts/backup.sh; the archive is AES-256 encrypted with this passphrase: keep a copy OFF the server) ---
BACKUP_PASSPHRASE=CHANGE_ME
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# --- Secrets (run ./scripts/gen-secrets.sh to fill these) ---
N8N_ENCRYPTION_KEY=
GRIST_SESSION_SECRET=

# --- Grist ---
# The Google account you will log in with as Grist admin
GRIST_ADMIN_EMAIL=you@gmail.com
# Single team site name: lowercase, no spaces
GRIST_TEAM_NAME=agency

# Formula sandbox: gvisor on a server. On a laptop (Docker Desktop) use unsandboxed if formulas error.
GRIST_SANDBOX_FLAVOR=gvisor

# --- Google sign-in for Grist (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NO-DOMAIN mode only (docker-compose.nodomain.yml) ---
# Your laptop's Tailscale name, shown by `tailscale status` / admin console, e.g. vatsal-laptop.tail1234.ts.net
TS_HOSTNAME=

# --- FREE laptop mode with your own domain (docker-compose.local.yml) ---
# Cloudflare Zero Trust > Networks > Tunnels > Create tunnel (Cloudflared) > copy the token
CLOUDFLARE_TUNNEL_TOKEN=

# --- FlowHQ clinic workflow (read by n8n as $env.FLOWHQ_*; docker-compose.yml passes them to the n8n container) ---
# Placeholders only. Put the real values in the server's .env (chmod 600), never in git. Full explanation: docs/INSTALL.md and config/env/n8n-flowhq.env.example
FLOWHQ_GRIST_URL=http://grist:8484
FLOWHQ_REGISTRY_DOC_ID=
FLOWHQ_DEFAULT_COUNTRY_CODE=91
FLOWHQ_WA_SEND_MODE=off
FLOWHQ_WA_ALLOWLIST=
FLOWHQ_WA_GRAPH_VERSION=v23.0
FLOWHQ_WA_TEMPLATE_LANGUAGE=en
FLOWHQ_WA_ALLOW_HELLO_WORLD=false
FLOWHQ_META_APP_SECRET=
FLOWHQ_META_VERIFY_TOKEN=
FLOWHQ_W2_IMPLIED_CONSENT=true
FLOWHQ_W1_REQUIRE_CONSENT=true
FLOWHQ_CAL_WEBHOOK_SECRET=
FLOWHQ_CAL_MAX_AGE_HOURS=24
FLOWHQ_TELEGRAM_CHAT_ID=
FLOWHQ_TEST_PHONE=
FLOWHQ_ALERT_EMAIL_TO=
FLOWHQ_EMAIL_FROM=
FLOWHQ_EMAIL_PATIENT_ACK=false
# External AI (OpenRouter): one switch, exactly 'true' enables it. The key is NOT here, it is the n8n credential 'OpenRouter API'. See docs/OPENROUTER.md
FLOWHQ_AI_EXTERNAL_ENABLED=false
FLOWHQ_AI_MODEL=openai/gpt-4o-mini
FLOWHQ_AI_MAX_REPLIES_PER_HOUR=6
# Slice 4C: set to 12 BEFORE switching AI booking on (each booking, move or cancel costs two replies because the patient is asked to confirm first)
# FLOWHQ_AI_MAX_REPLIES_PER_HOUR=12
# Slice 4C: where W13 reaches the FLOW HQ booking API, over the private Docker network. Empty = W13 books nothing through the CRM (fail closed).
# Needs the n8n credential "FlowHQ Booking API" (Header Auth: Authorization = Bearer <token from booking-token>). docs/n8n-4c-changes.md
FLOWHQ_BOOKING_API_URL=
