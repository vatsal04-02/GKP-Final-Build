# FLOW HQ server settings. Copy to flowhq/.env and fill in. NEVER commit .env (it is git-ignored).
# Every value here stays on the server: the browser never receives any of them.

PORT=8787

# Demo mode: built-in sample businesses, no backend needed. Keep false in production.
FLOWHQ_DEMO=false

# --- The Clinic Autopilot backend (Grist) ---
# Inside the Docker stack Grist is http://grist:8484. Outside it, use your Grist URL (https://...).
GRIST_BASE_URL=http://grist:8484
# A Grist API key (Grist > Profile settings > API). Best: a dedicated Grist user for FLOW HQ with access to the
# Agency Registry doc and the clinic docs only, so it can be revoked on its own.
GRIST_API_KEY=
# The Agency Registry doc id (table Clinics: Clinic_Slug, Clinic_Name, Grist_Doc_ID, WA_Phone_Number_ID, Active)
GRIST_REGISTRY_DOC_ID=
# Name of the leads table in the clinic docs (the live docs use LEADS)
GRIST_LEADS_TABLE=LEADS

# --- Locale for numbers, dates and money ---
FLOWHQ_TIMEZONE=Asia/Kolkata
FLOWHQ_LOCALE=en-IN
FLOWHQ_CURRENCY=INR
# Industry for workspaces that have no profile yet (clinic, physiotherapy, salon, spa, gym, consultant, agency, real_estate,
# coaching, education, local_services, home_services, professional_services, custom)
FLOWHQ_DEFAULT_INDUSTRY=clinic

# --- Sign-in ---
# At least 32 random characters, e.g.: openssl rand -base64 48
FLOWHQ_SESSION_SECRET=
# true behind HTTPS (Caddy). Only set false for plain-http local testing.
FLOWHQ_SECURE_COOKIES=true
# Users: a JSON file (see config/users.example.json) or the same JSON inline in FLOWHQ_USERS
FLOWHQ_USERS_FILE=config/users.json
# FLOWHQ_USERS=
# Workspace profiles (industry, display name, logo, words, modules). Written by Settings; created on first save.
FLOWHQ_WORKSPACES_FILE=config/workspaces.json

# --- Appointment booking (docs/booking-operations.md, docs/production-readiness.md) ---
# true when FLOW HQ is reached ONLY through the reverse proxy (production: Caddy). The caller's address is then the LAST X-Forwarded-For entry.
# Set false if FLOW HQ is ever reachable without a proxy, otherwise a caller can fake its address and dodge the token rate limit.
FLOWHQ_TRUST_PROXY=true
# The durable audit outbox. It MUST be on a persistent volume (the flowhq_config volume mounts /app/flowhq/config).
FLOWHQ_AUDIT_OUTBOX_DIR=config/audit-outbox
# true (the image default on Linux in production): refuse an outbox on the container's own layer, which is lost when the container is re-created. Bookings are refused until fixed.
FLOWHQ_AUDIT_REQUIRE_VOLUME=true
# Emergency only (docs/booking-operations.md): allow bookings while the outbox is unavailable. Every use is counted and shown to admins. Leave false.
FLOWHQ_AUDIT_BREAKGLASS=false
# Service tokens for the n8n booking API: a JSON file (hashes only) or the same JSON inline. Create with: node dist/tools/booking-token.mjs <id> <clinic-slug> --days 90 --write
FLOWHQ_BOOKING_TOKENS_FILE=config/booking-tokens.json
# FLOWHQ_BOOKING_TOKENS=

# --- Optional paths (defaults work for the repository layout and the Docker image) ---
# FLOWHQ_STATIC_DIR=dist/web
# FLOWHQ_SNIPPETS_DIR=../n8n/snippets
# Clinic letterhead, clinicians and invoice rules for the printed prescription / invoice (public details, no secrets). See README L.
# FLOWHQ_CLINIC_FILE=config/clinic.json
