{
  "name": "flowhq",
  "version": "0.1.0",
  "private": true,
  "description": "FLOW HQ - universal business automation OS (web app + BFF). First backend: the Clinic Autopilot Grist + n8n workflow.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n bff,web \"npm:dev:bff\" \"npm:dev:web\"",
    "dev:bff": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:bff && npm run build:tools",
    "build:web": "vite build",
    "build:bff": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server/index.js --packages=external",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:real-grist": "vitest run tests/real-grist --no-file-parallelism",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "test:e2e:clinical": "node tests/e2e/clinical-e2e.mjs",
    "hash-password": "tsx src/server/tools/hash-password.ts",
    "provision-records": "tsx src/server/tools/provision-records.ts",
    "provision-booking": "tsx src/server/tools/provision-booking.ts",
    "provision-payments": "tsx src/server/tools/provision-payments.ts",
    "booking-token": "tsx src/server/tools/booking-token.ts",
    "audit-outbox": "tsx src/server/tools/audit-outbox.ts",
    "build:tools": "esbuild src/server/tools/audit-outbox.ts src/server/tools/provision-booking.ts src/server/tools/provision-payments.ts src/server/tools/provision-records.ts src/server/tools/booking-token.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist/tools --out-extension:.js=.mjs",
    "start:env": "node --env-file=.env dist/server/index.js"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@tanstack/react-query": "5.59.20",
    "clsx": "2.1.1",
    "hono": "4.13.14",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "esbuild": "0.24.0",
    "playwright": "1.56.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
